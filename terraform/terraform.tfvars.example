# Copy to terraform.tfvars (gitignored) and fill in: cp terraform.tfvars.example terraform.tfvars
# Secrets never go here; create them as SSM SecureStrings under /<project_name>/ (see README, Production step 1).

# Required
api_domain        = "api.example.com"
acme_email        = "you@example.com"
repository_url    = "https://github.com/YOUR_ORG/YOUR_REPO.git"
github_repository = "YOUR_ORG/YOUR_REPO"

# Optional; defaults shown
# aws_region                  = "eu-north-1"
# project_name                = "task-api"
# instance_type               = "t4g.small"
# root_volume_size            = 20
# vpc_cidr                    = "10.0.0.0/16"
# backup_retention_days       = 30
# create_github_oidc_provider = true
