# Copy to .env and replace every value before running: cp .env.example .env

# Database
POSTGRES_USER=app
POSTGRES_PASSWORD=change-me
POSTGRES_DB=app
DATABASE_URL=postgresql://app:change-me@db:5432/app

# Auth (generate with: openssl rand -hex 32)
SECRET_KEY=
ACCESS_TOKEN_EXPIRE_MINUTES=30

# Grafana
GF_SECURITY_ADMIN_PASSWORD=change-me
GF_SERVER_ROOT_URL=http://localhost/grafana

# Backups: interval and how many days of dumps to keep in the local backup_data volume
BACKUP_INTERVAL_SECONDS=86400
BACKUP_KEEP_DAYS=7

# Production only (docker-compose.prod.yaml): bare hostname, no scheme or trailing slash
DOMAIN=example.com
ACME_EMAIL=you@example.com
# Cloudflare API token with Zone:DNS:Edit, used by Traefik for the Let's Encrypt DNS challenge
CF_DNS_API_TOKEN=
# S3 bucket for backup uploads and its region, from: terraform output -raw backup_bucket / aws_region
BACKUP_S3_BUCKET=
AWS_REGION=
